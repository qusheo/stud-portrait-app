    "dependencies": {
        "@tanstack/react-query": "^5.104.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/user-event": "^13.5.0",
        "antd": "^6.6.7",
        "apexcharts": "^5.3.5",
        "axios": "^1.20.0",
        "echarts": "^6.0.0",
        "echarts-for-react": "^3.0.6",
        "exceljs": "^4.4.0",
        "ioredis": "^5.11.1",
        "lucide-react": "^1.7.0",
        "rc-slider": "^11.1.9",
        "react": "^19.2.0",
        "react-apexcharts": "^1.7.0",
        "react-dom": "^19.2.0",
        "react-heatmap-grid": "^0.9.1",
        "react-router-dom": "^7.9.4",
        "react-select": "^5.10.2",
        "react-toastify": "^11.1.0",
        "recharts": "^3.7.0",
        "tanstack": "^2.0.3",
        "web-vitals": "^2.1.4",
        "zustand": "^5.0.15"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "npx vitest run",
        "test:visual": "node test/selenium/visual-runner.js",
        "test:functional": "npx jest test/selenium/ --config=jest.config.js --testPathIgnorePatterns=VisualTests.test.js",
        "test:all": "npm run test:functional && npm run test:visual && npx vitest run",
        "test:selenium": "npx jest --config=jest.config.js --verbose",
        "test:selenium:edge": "node tests/selenium/edge-runner.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@applitools/eyes-selenium": "^4.82.13",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "baseline-browser-mapping": "^2.11.28",
        "chai": "^6.2.0",
        "chromedriver": "^141.0.4",
        "cross-env": "^10.1.0",
        "edgedriver": "^6.1.2",
        "expect": "^30.2.0",
        "husky": "^9.1.7",
        "jest": "^27.5.1",
        "jsdom": "^26.1.0",
        "lint-staged": "^17.5.0",
        "mocha": "^11.7.4",
        "onchange": "^7.1.0",
        "prettier": "^3.9.6",
        "sass": "^1.93.2",
        "selenium-webdriver": "^4.38.0",
        "vite": "^5.4.21",
        "vitest": "^3.2.4"
    }
}
